# Registration & Login Backend Service
# Copy this file to .env and fill in real values before running the application.
# NEVER commit .env to version control.

# ============================================================
# DATABASE (MySQL 8.0+)
# ============================================================
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/reglog_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=reglog_user
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_strong_db_password

# ============================================================
# JWT CONFIGURATION
# ============================================================
# Generate with: openssl rand -base64 32
# Must decode to at least 32 bytes (256 bits). The app will fail to start if this is missing or weak.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# Token lifetime in milliseconds. Default: 1800000 (30 minutes)
JWT_EXPIRATION_MS=1800000

# Issuer name embedded in the token
JWT_ISSUER=reg-log-backend

# ============================================================
# COOKIE CONFIGURATION
# ============================================================
AUTH_COOKIE_NAME=AUTH_TOKEN

# Set to false for local HTTP development, true for production HTTPS
COOKIE_SECURE=false

# ============================================================
# CORS — Frontend Origin
# ============================================================
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

# ============================================================
# SMTP / EMAIL (for OTP delivery)
# ============================================================
# For Gmail: use an App Password (not your Gmail login password).
# Create one at: https://myaccount.google.com/apppasswords
# For production: use a dedicated email provider (SendGrid, Mailgun, AWS SES, etc.)

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=CHANGE_ME_gmail_app_password_16_chars
MAIL_FROM=noreply@yourdomain.com
